# Copy to .env to override. docker compose works with no .env at all; these are the defaults.
# Variables marked (app) are read by app/config.py; the rest only shape docker-compose.yml.

# --- infrastructure credentials (compose)
POSTGRES_USER=callevents
POSTGRES_PASSWORD=callevents
POSTGRES_DB=callevents
RABBITMQ_USER=callevents
RABBITMQ_PASSWORD=callevents

# --- connections (app). Compose builds these from the values above; set them yourself when
# running the app outside compose.
DATABASE_URL=postgresql://callevents:callevents@localhost:5432/callevents
REDIS_URL=redis://localhost:6379/0
BROKER_URL=amqp://callevents:callevents@localhost:5672//
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# --- general (app)
APP_ENV=development
LOG_LEVEL=INFO

# --- inbound provider signing secrets (app). Change these for anything real.
ACMETEL_SIGNING_SECRET=dev-acmetel-secret
VOXLY_SIGNING_SECRET=dev-voxly-secret
VOXLY_SIGNATURE_TOLERANCE_SECONDS=300

# --- outbound delivery (app)
DELIVERY_TIMEOUT_SECONDS=10
DELIVERY_MAX_ATTEMPTS=6
DELIVERY_BACKOFF_BASE_SECONDS=1
DELIVERY_BACKOFF_FACTOR=4
DELIVERY_BACKOFF_JITTER=0.2
DELIVERY_LEASE_SECONDS=120
DELIVERY_DISPATCH_GRACE_SECONDS=60
ENDPOINT_RATE_PER_SECOND=50
ENDPOINT_BURST=100
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_SECONDS=30

# --- read API and caches (app)
READ_RATE_LIMIT=600
READ_RATE_WINDOW_SECONDS=60
ENDPOINT_CACHE_TTL_SECONDS=300
API_KEY_CACHE_TTL_SECONDS=300

# --- process sizing
API_WORKERS=2
WORKER_CONCURRENCY=32
WORKER_METRICS_PORT=9100

# --- seed data (app, scripts/seed.py)
DEMO_API_KEY=ck_demo_0123456789abcdef0123456789abcdef
DEMO_ENDPOINT_SECRET=whsec_demo_receiver_secret
DEMO_RECEIVER_BASE_URL=http://receiver:8080

# --- test receiver (compose)
RECEIVER_FAIL_RATE=0.1
RECEIVER_LATENCY_MS=20

# --- tests (pytest)
TEST_DATABASE_URL=postgresql://callevents:callevents@localhost:5432/callevents_test
TEST_REDIS_URL=redis://localhost:6379/15
